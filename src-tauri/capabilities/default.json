{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Every Lectrix window (the first, and those made for tabs moved out of another): core events, the window controls of the custom title bar, full screen, and Lectrix's own commands. File access goes through Rust-side dialogs, drag-and-drop and the command line, never through paths from the webview.",
  "windows": ["main", "window-*"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "allow-open-with-dialog",
    "allow-open-startup-documents",
    "allow-open-recent",
    "allow-remove-recent",
    "allow-set-recent-pinned",
    "allow-show-recent-in-folder",
    "allow-list-recent-files",
    "allow-list-recovered",
    "allow-restore-recovered",
    "allow-discard-recovered",
    "allow-exit-confirmed",
    "allow-unlock-document",
    "allow-cancel-unlock",
    "allow-close-document",
    "allow-get-document-info",
    "allow-list-open-documents",
    "allow-get-page-text",
    "allow-search-text",
    "allow-apply-operation",
    "allow-open-merge-sources",
    "allow-open-insert-sources",
    "allow-set-drop-target",
    "allow-plan-merge",
    "allow-execute-merge",
    "allow-extract-pages",
    "allow-cancel-merge",
    "allow-set-bookmark-open",
    "allow-enable-editing",
    "allow-undo",
    "allow-redo",
    "allow-save",
    "allow-save-as",
    "allow-reload-document",
    "allow-remember-view",
    "allow-scan-annotations-for-repair",
    "allow-repair-annotations",
    "allow-get-settings",
    "allow-set-settings",
    "allow-reset-settings",
    "allow-app-ready",
    "allow-set-pane-layout",
    "allow-log-metric",
    "allow-log-error",
    "allow-open-web-page",
    "allow-window-chrome",
    "allow-set-menu",
    "allow-open-link",
    "allow-move-document",
    "allow-list-windows",
    "allow-close-other-windows",
    "allow-check-for-update",
    "allow-skip-update",
    "allow-download-update",
    "allow-cancel-update-download",
    "allow-restart-to-update"
  ]
}
