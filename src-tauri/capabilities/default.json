{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core events, the window controls of the custom title bar, and Folio's own commands. File access goes through Rust-side dialogs, drag-and-drop and the command line, never through paths from the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "allow-open-with-dialog",
    "allow-open-startup-documents",
    "allow-open-recent",
    "allow-remove-recent",
    "allow-list-recent-files",
    "allow-unlock-document",
    "allow-cancel-unlock",
    "allow-close-document",
    "allow-get-document-info",
    "allow-get-page-text",
    "allow-search-text",
    "allow-apply-operation",
    "allow-undo",
    "allow-redo",
    "allow-save",
    "allow-save-as",
    "allow-reload-document",
    "allow-remember-view",
    "allow-app-ready",
    "allow-log-metric",
    "allow-log-error"
  ]
}
