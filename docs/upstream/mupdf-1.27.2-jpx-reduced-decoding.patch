+fz_pixmap *fz_load_jpx_reduced(fz_context *ctx, const unsigned char *data, size_t size, fz_colorspace *defcs, int *reduce);
+
+fz_pixmap *
+fz_load_jpx_reduced(fz_context *ctx, const unsigned char *data, size_t size, fz_colorspace *defcs, int *reduce)
+{
+	fz_jpxd state = { 0 };
+	fz_pixmap *pix = NULL;
+	int wanted = *reduce;
+	int failed = 0;
+
+	if (wanted <= 0)
+	{
+		*reduce = 0;
+		return fz_load_jpx(ctx, data, size, defcs);
+	}
+
+	fz_try(ctx)
+	{
+		fz_opj_lock(ctx);
+		pix = jpx_read_image(ctx, &state, data, size, defcs, 0, reduce);
+	}
+	fz_always(ctx)
+		fz_opj_unlock(ctx);
+	fz_catch(ctx)
+	{
+		fz_rethrow_if(ctx, FZ_ERROR_SYSTEM);
+		fz_report_error(ctx);
+		failed = 1;
+	}
+
+	if (failed)
+	{
+		/* A reduced decode failed: decode in full, as MuPDF always did. */
+		*reduce = 0;
+		pix = fz_load_jpx(ctx, data, size, defcs);
+	}
+	return pix;
+}
